# Copy to .env and fill in. .env is gitignored - never commit it.

# --- Required: email delivery (Resend API) -----------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address on a Resend-verified domain.
# (Unverified senders may only deliver to your own Resend account address.)
SENDER_EMAIL=

# Where the weekly report is delivered.
RECIPIENT_EMAIL=

# --- Optional ----------------------------------------------------------
# Raises the GitHub Search API rate limit above the anonymous tier.
# Local only: in GitHub Actions this is provided automatically and must
# NOT be added as a repository secret (the name is reserved).
# Create one at https://github.com/settings/tokens - no scopes needed.
GITHUB_TOKEN=

# Set to any non-empty value to make a dead source a hard failure instead of
# a quietly incomplete report. GitHub and Reddit must each return at least 1
# item; Hacker News may legitimately return 0 on a quiet news day, but still
# fails if more than half of its item fetches error out (an outage, not a
# quiet day). The workflow sets this in CI. Leave unset locally to keep the
# forgiving behaviour.
STRICT_SOURCES=
